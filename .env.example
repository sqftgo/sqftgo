# Supabase (required) — copy to .env.local and fill from Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the new publishable key (or use legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Canonical site URL used for auth email redirects (no trailing slash).
# REQUIRED in production — must match Supabase Auth → URL Configuration Site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — required for admin user management + local seeding.
# Dashboard → Project Settings → API → service_role (secret)
# Never expose this to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Rate limiting (recommended in production / multi-instance)
# Create a Redis DB at https://console.upstash.com → REST API credentials
# When unset, an in-memory limiter is used (single instance only).
# UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Email confirmation skip — LOCAL / STAGING ONLY.
# Forced OFF whenever NODE_ENV=production (AUTH_SKIP_EMAIL_CONFIRM=true is ignored in prod).
# AUTH_SKIP_EMAIL_CONFIRM=false
# AUTH_DEV_AUTO_CONFIRM=true

# After setting the service role key locally:
#   pnpm seed:demo-users
# Demo passwords are LOCAL ONLY. Rotate before any shared/staging/production deploy.
#   user@sqftgo.com / user2026 , broker@sqftgo.com / broker2026
# Admin (not shown on login UI): admin@sqftgo.com / admin2026
